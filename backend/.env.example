# Copy this file to .env in the same folder (backend/) and adjust values.

PORT=5000

# Local MongoDB (install MongoDB Community, then run: mongod)
MONGO_URI=mongodb://127.0.0.1:27017/watchify

# Or use MongoDB Atlas (replace with your connection string; allow your IP in Atlas Network Access)
# MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/watchify?retryWrites=true&w=majority

# Any long random string for development (use a real secret in production)
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars
